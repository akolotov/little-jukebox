# Each installation has its own directory and its own .env file. These values
# configure staging. Production must use distinct deployment values.
COMPOSE_PROJECT_NAME=little-jukebox-staging

# Rebuild and reuse this exact tag for staging. Production uses a published,
# immutable version such as ghcr.io/owner/little-jukebox:1.0.0.
JUKEBOX_IMAGE=little-jukebox:local
JUKEBOX_PULL_POLICY=never

# These values must be unique on the shared Tailscale ingress.
JUKEBOX_DOCKER_ALIAS=little-jukebox-staging
JUKEBOX_BASE_PATH=/apps/little-jukebox-staging
