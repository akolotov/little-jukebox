proxy_cache_path /var/cache/nginx/thumbnails levels=1:2
  keys_zone=thumbnails:2m max_size=128m inactive=30d use_temp_path=off;

server {
  listen 127.0.0.1:8081;
  server_name _;
  access_log off;

  location /thumbs/ {
    alias /data/covers/;
    error_page 404 = @missing_thumbnail;
    image_filter resize 360 -;
    image_filter_jpeg_quality 75;
    image_filter_buffer 10M;
  }

  location @missing_thumbnail {
    image_filter off;
    return 404;
  }

  location / {
    return 404;
  }
}

server {
  listen 8080;
  server_name _;

  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  location = ${JUKEBOX_BASE_PATH} {
    return 301 ${JUKEBOX_BASE_PATH}/;
  }

  location = ${JUKEBOX_BASE_PATH}/ {
    alias /usr/share/nginx/html/;
    index index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
  }

  location = ${JUKEBOX_BASE_PATH}/index.html {
    alias /usr/share/nginx/html/index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
  }

  location = ${JUKEBOX_BASE_PATH}/catalog.json {
    alias /data/catalog.json;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
  }

  location ${JUKEBOX_BASE_PATH}/covers/ {
    alias /data/covers/;
    add_header Cache-Control "no-cache" always;
  }

  location ${JUKEBOX_BASE_PATH}/thumbs/ {
    proxy_pass http://127.0.0.1:8081/thumbs/;
    proxy_cache thumbnails;
    proxy_cache_key "thumb360-q75-v1:$uri$is_args$args";
    proxy_cache_valid 200 7d;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 30s;
    proxy_cache_lock_age 30s;
    proxy_read_timeout 30s;
    add_header X-Thumbnail-Cache $upstream_cache_status always;
    add_header Cache-Control "public, max-age=604800";
  }

  location ${JUKEBOX_BASE_PATH}/audio/ {
    alias /data/music/;
    add_header Cache-Control "no-cache" always;
  }

  location / {
    return 404;
  }
}
